#!/bin/sh

file="$1"
w="$2"
h="$3"
x="$4"
y="$5"

mime="$(file -Lb --mime-type "$file")"

case "$mime" in

    # ─────────────────────────────────────────
    # IMMAGINI
    # ─────────────────────────────────────────

    image/*)
        kitten icat \
            --silent \
            --stdin=no \
            --transfer-mode=file \
            --place "${w}x${h}@${x}x${y}" \
            "$file" \
            </dev/null \
            >/dev/tty
        exit 1
        ;;

    # ─────────────────────────────────────────
    # PDF
    # ─────────────────────────────────────────

    application/pdf)
        pdftoppm \
            -f 1 \
            -singlefile \
            -jpeg \
            -scale-to "$((w * 8))" \
            "$file" \
            /tmp/lf-preview \
            2>/dev/null

        if [ -f /tmp/lf-preview.jpg ]; then
            kitten icat \
                --silent \
                --stdin=no \
                --transfer-mode=file \
                --place "${w}x${h}@${x}x${y}" \
                /tmp/lf-preview.jpg \
                </dev/null \
                >/dev/tty
        fi

        exit 1
        ;;

    # ─────────────────────────────────────────
    # VIDEO
    # ─────────────────────────────────────────

    video/*)
        thumbnail="/tmp/lf-video-preview.jpg"

        ffmpegthumbnailer \
            -i "$file" \
            -o "$thumbnail" \
            -s 0 \
            -q 8 \
            2>/dev/null

        if [ -f "$thumbnail" ]; then
            kitten icat \
                --silent \
                --stdin=no \
                --transfer-mode=file \
                --place "${w}x${h}@${x}x${y}" \
                "$thumbnail" \
                </dev/null \
                >/dev/tty
        fi

        exit 1
        ;;

    # ─────────────────────────────────────────
    # SVG
    # ─────────────────────────────────────────

    image/svg+xml)
        chafa \
            --format=symbols \
            --size "${w}x${h}" \
            "$file" \
            2>/dev/null
        ;;

    # ─────────────────────────────────────────
    # TESTO / CODICE / ARCHIVI / FALLBACK
    # ─────────────────────────────────────────

    *)
        pistol "$file"
        ;;

esac
