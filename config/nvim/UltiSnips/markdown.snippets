global !p
import re

def math():
    row, col = vim.current.window.cursor
    line = vim.current.line

    # -------------------------------------------------
    # Caso immediato: cursore dentro $$
    # Es: $|$ oppure $$|$$
    # -------------------------------------------------

    # $|$
    if col > 0 and col < len(line):
        if line[col-1] == '$' and line[col] == '$':
            return True

    # $$|$$
    if col > 1 and col < len(line)-1:
        if line[col-2:col] == '$$' and line[col:col+2] == '$$':
            return True

    # -------------------------------------------------
    # Testo prima del cursore
    # -------------------------------------------------

    lines = vim.current.buffer[:row]
    if lines:
        lines[-1] = lines[-1][:col]

    text = "\n".join(lines)

    # -------------------------------------------------
    # $$ ... $$
    # -------------------------------------------------

    display = re.findall(r'(?<!\\)\$\$', text)
    if len(display) % 2 == 1:
        return True

    # Rimuove $$ per non contare due volte i $
    text_no_display = re.sub(r'(?<!\\)\$\$', '', text)

    # -------------------------------------------------
    # $ ... $
    # -------------------------------------------------

    inline = re.findall(r'(?<!\\)\$', text_no_display)
    if len(inline) % 2 == 1:
        return True

    # -------------------------------------------------
    # \[ ... \]
    # -------------------------------------------------

    open_bracket = len(re.findall(r'\\\[', text))
    close_bracket = len(re.findall(r'\\\]', text))

    if open_bracket > close_bracket:
        return True

    # -------------------------------------------------
    # \begin{...}
    # -------------------------------------------------

    begins = re.findall(
        r'\\begin\{(equation\*?|align\*?|gather\*?|multline\*?)\}',
        text
    )

    ends = re.findall(
        r'\\end\{(equation\*?|align\*?|gather\*?|multline\*?)\}',
        text
    )

    if len(begins) > len(ends):
        return True

    return False
endglobal
